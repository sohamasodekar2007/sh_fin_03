# ===========================================================================
# CloudCare — .env template
#
# Copy to `.env` at the monorepo root. NEVER commit it (check .gitignore).
#
# Every value below is a placeholder ON PURPOSE. The secrets you pasted into
# chat are compromised and must be regenerated before you fill this in.
# ===========================================================================

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ENV=development
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,https://sh-fin-03.vercel.app
APP_BASE_URL=http://localhost:3000
DEMO_MODE=false

# ---------------------------------------------------------------------------
# MongoDB  — rotate the password in Atlas > Database Access
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xs5mzif.mongodb.net/cloudcare?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=cloudcare

# ---------------------------------------------------------------------------
# Auth  — openssl rand -hex 32
# ---------------------------------------------------------------------------
JWT_SECRET=<openssl rand -hex 32>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
APPROVAL_TOKEN_SECRET=<openssl rand -hex 32, DIFFERENT from JWT_SECRET>

# 2FA for now. WebAuthn stays in the codebase but unreachable from the UI.
AUTH_FACTORS=2
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=CloudCare
WEBAUTHN_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# SSO (NextAuth, frontend .env.local — repeated here for the backend callback)
# ---------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=<openssl rand -base64 32 — NOT a passphrase>
GOOGLE_CLIENT_ID=373602839202-e5aa9976vugrc39p7u944l1cm49fkh01.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<reset in Cloud Console, the pasted one is burned>
GITHUB_CLIENT_ID=Ov23liUG7ltDO2to54Vw
GITHUB_CLIENT_SECRET=<regenerate in GitHub developer settings>

# ---------------------------------------------------------------------------
# LLM — GPT-4o for BOTH the Decision agent and the chatbot
#
# Direct OpenAI:  OPENAI_BASE_URL=https://api.openai.com/v1  + your sk-proj- key
# Via a proxy:    OPENAI_BASE_URL=<proxy>/v1                 + the PROXY's key
# Do not send an OpenAI key to a third-party base URL.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=<rotated key>
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# AWS — account 350381001148
# Two roles: read for collection, write for execution. Never one role for both.
# ---------------------------------------------------------------------------
AWS_ACCOUNT_ID=350381001148
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=<NEW key, old one deleted in IAM>
AWS_SECRET_ACCESS_KEY=<NEW secret>
AWS_EXTERNAL_ID=<generate a UUID, used as the AssumeRole trust condition>
AWS_READ_ROLE_ARN=arn:aws:iam::350381001148:role/CloudCareReadOnlyRole
AWS_WRITE_ROLE_ARN=arn:aws:iam::350381001148:role/CloudCareExecutorRole

# Real FOCUS 1.0 export (optional — synthesis is the fallback)
FOCUS_EXPORT_S3_BUCKET=
FOCUS_EXPORT_S3_PREFIX=

# ---------------------------------------------------------------------------
# Azure — subscription 955c7106-5f99-4b1a-8898-945ed8db3d2c
# App needs: Cost Management Reader + Reader + Monitoring Reader at sub scope
# ---------------------------------------------------------------------------
AZURE_SUBSCRIPTION_ID=955c7106-5f99-4b1a-8898-945ed8db3d2c
AZURE_TENANT_ID=183c1ca9-36ab-4189-b80e-539067837c7a
AZURE_CLIENT_ID=356675d0-4a06-4eb1-817a-d88988493247
AZURE_CLIENT_SECRET=<NEW secret from Entra ID, the pasted one is burned>
AZURE_FOCUS_STORAGE_ACCOUNT=
AZURE_FOCUS_CONTAINER=

# ---------------------------------------------------------------------------
# GCP — not connected, uses FOCUS sample data
# ---------------------------------------------------------------------------
GCP_SERVICE_ACCOUNT_JSON=
GCP_BILLING_BQ_DATASET=

# ---------------------------------------------------------------------------
# VPS — company-owned server. SSH primary, node_exporter optional.
# Create a dedicated key-only user with no sudo. Never reuse an admin key.
# See docs/VPS_SETUP.md (generated in Phase 2c) for the server-side commands.
# ---------------------------------------------------------------------------
VPS_ENABLED=true
VPS_HOST=
VPS_PORT=22
VPS_USERNAME=cloudcare
VPS_SSH_KEY_PATH=~/.ssh/cloudcare_vps
VPS_SSH_KEY_PASSPHRASE=
VPS_COMPANY_NAME=Team Alpha

# Cost model. Change the currency to USD if 1.8k meant dollars, not rupees.
# Converted to USD at ingestion; the original is kept in x_OriginalBilledCost.
VPS_MONTHLY_COST=1800
VPS_MONTHLY_COST_CURRENCY=INR
VPS_COST_ALLOCATION=vcpu_share

# Optional Prometheus / node_exporter. Preferred over SSH when set.
VPS_METRICS_ENDPOINT=

# One-time sysstat backfill on first connect (gives a real 14-day history)
VPS_SAR_BACKFILL_ENABLED=true
VPS_SAR_BACKFILL_DAYS=14

# ---------------------------------------------------------------------------
# FOCUS
# ---------------------------------------------------------------------------
FOCUS_VERSION=1.0
FOCUS_SAMPLE_REPO_PATH=.focus-samples
FOCUS_SAMPLE_REPO_URL=https://github.com/FinOps-Open-Cost-and-Usage-Spec/FOCUS-Sample-Data

# ---------------------------------------------------------------------------
# Currency — USD stored, INR displayed as a subscript
# ---------------------------------------------------------------------------
USD_TO_INR=83.0
FX_RATE_SOURCE=static

# ---------------------------------------------------------------------------
# Email (Brevo) — sender must be verified under Senders & Domains
# ---------------------------------------------------------------------------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=b2cc03001@smtp-brevo.com
SMTP_PASSWORD=<regenerate in Brevo>
SMTP_FROM=teamalpha817@gmail.com
BREVO_API_KEY=<regenerate in Brevo>

# ---------------------------------------------------------------------------
# Scheduler
# ---------------------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=60
SCHEDULER_MAX_CONCURRENT_ACCOUNTS=4

# ---------------------------------------------------------------------------
# Execution safety — keep false until Phase 6 passes in simulation
# ---------------------------------------------------------------------------
EXECUTION_ENABLED=false
EXECUTION_MODE=simulation
EXECUTION_ALLOWLIST_TAG=cloudcare:managed=true
EXECUTION_VERIFY_DELAY_SECONDS=60

# SQS execution queue — production async executor. When enabled, approvals
# enqueue jobs first, then the API-managed worker processes them safely.
SQS_EXECUTION_ENABLED=false
SQS_EXECUTION_QUEUE_URL=
SQS_ENDPOINT_URL=
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=300
SQS_MAX_MESSAGES=5


# ===========================================================================
# Frontend — apps/frontend/.env.local (separate file)
# ===========================================================================
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_USD_TO_INR=83.0
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=<same value as backend>
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GITHUB_CLIENT_ID=...
# GITHUB_CLIENT_SECRET=...
