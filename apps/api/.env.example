APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# MongoDB Atlas connection string — mongodb.com/cloud/atlas (free tier is enough)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=cloudcare

# MUST be byte-for-byte identical to NEXTAUTH_SECRET in apps/web/.env.local —
# this is how FastAPI trusts a JWT NextAuth minted. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256

# AES-256-GCM key for CloudAccount.encrypted_credentials — must decode from
# base64 to exactly 32 bytes. Generate with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# AWS — a single dev-account fallback role used only when a tenant hasn't
# onboarded their own CloudAccount yet. Create a read-only IAM role in a
# sandbox account and put its ARN + external ID here.
AWS_REGION=us-east-1
AWS_READ_ROLE_ARN=
AWS_EXTERNAL_ID=

# OpenAI — powers the Decision Agent's structured-output reasoning
# (services/decision/llm.py) and the chat orchestrator (services/chat).
# Leave empty and both features degrade to deterministic-only behavior.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Execution safety — the Executor never makes a live cloud API call
# regardless of this flag (see services/executor/simulated_executor.py);
# it only toggles whether AUTO_APPROVE proposals get status="simulated" or
# status="disabled" in the audit ledger.
EXECUTION_ENABLED=false
