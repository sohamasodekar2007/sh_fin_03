# Copy this file to .env at the monorepo root and fill in real values.
# .env is gitignored - never commit real secrets.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ENV=development                                    # development | test | production
CORS_ORIGINS=http://localhost:3000,http://localhost:3001  # comma-separated allowed origins

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# PLACEHOLDER: get this from MongoDB Atlas (free tier is fine for a hackathon)
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<db-name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/cloudcare?retryWrites=true&w=majority
MONGODB_DB_NAME=cloudcare                              # database name inside the cluster

# ---------------------------------------------------------------------------
# Auth (JWT)
# ---------------------------------------------------------------------------
JWT_SECRET=replace-this-with-a-long-random-string       # openssl rand -hex 32
JWT_EXPIRE_MINUTES=60                                    # access token lifetime
JWT_ALGORITHM=HS256                                      # jose signing algorithm

# ---------------------------------------------------------------------------
# SMTP / transactional email (OTP delivery)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com                                # SMTP relay host
SMTP_PORT=587                                            # SMTP relay port
SMTP_USERNAME=                                           # SMTP login (e.g. Brevo SMTP user)
SMTP_PASSWORD=                                           # SMTP login password/API key
SMTP_FROM=                                                # From: address shown to recipients
RESEND_API_KEY=                                           # optional, used instead of SMTP if set
BREVO_API_KEY=                                            # optional, used instead of SMTP if set

# ---------------------------------------------------------------------------
# Approval loop (Phase 5) — the Supervisor's email approve/deny links
# ---------------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000                        # frontend origin the email buttons link into (/approve/<token>)
APPROVAL_TOKEN_SECRET=replace-this-with-a-long-random-string  # openssl rand -hex 32, DIFFERENT from JWT_SECRET

# ---------------------------------------------------------------------------
# WebAuthn (third factor — code stays in repo, unreachable from the UI for now)
# ---------------------------------------------------------------------------
WEBAUTHN_RP_ID=localhost                                 # relying party ID (bare domain)
WEBAUTHN_RP_NAME=CloudCare                               # relying party display name
WEBAUTHN_ORIGIN=http://localhost:3000                    # expected origin of the frontend

# ---------------------------------------------------------------------------
# AWS
# ---------------------------------------------------------------------------
# Local development can set AWS_PROFILE=cloudcare-bootstrap.
# Render should leave AWS_PROFILE blank and use AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY from secret environment variables.
AWS_REGION=ap-south-1                                    # single source of truth for region
AWS_ACCOUNT_ID=                                           # 12-digit AWS account ID
AWS_PROFILE=                                              # local named profile, optional
AWS_ROLE_ARN=                                             # role to assume, if any
AWS_READ_ROLE_ARN=                                        # read-only role used by collectors
AWS_EXTERNAL_ID=                                          # external ID condition on the role trust policy
AWS_ACCESS_KEY_ID=                                        # long-lived key, local dev only
AWS_SECRET_ACCESS_KEY=                                    # long-lived secret, local dev only
FOCUS_EXPORT_S3_BUCKET=                                   # optional real AWS Data Exports FOCUS 1.0 bucket
FOCUS_EXPORT_S3_PREFIX=                                   # prefix under that bucket; synthesis is the fallback

# ---------------------------------------------------------------------------
# Azure
# ---------------------------------------------------------------------------
# The app registration needs a role assignment on the subscription — that's
# a separate step from creating the registration itself. See
# packages/azure/session.py:AzureClientFactory.verify_access().
AZURE_TENANT_ID=                                          # Entra ID (AAD) tenant
AZURE_CLIENT_ID=                                          # app registration (service principal) client ID
AZURE_CLIENT_SECRET=                                      # app registration client secret
AZURE_SUBSCRIPTION_ID=                                    # subscription to collect from
AZURE_FOCUS_STORAGE_ACCOUNT=                              # optional: real Cost Management FOCUS export storage account
AZURE_FOCUS_CONTAINER=                                    # container within that storage account; synthesis is the fallback

# ---------------------------------------------------------------------------
# VPS — company-owned server, no billing API. See docs/VPS_SETUP.md before
# filling this in — do not reuse an existing admin SSH key.
# ---------------------------------------------------------------------------
VPS_HOST=                                                 # server IP/hostname; blank = VPS provider not connected
VPS_PORT=22
VPS_USERNAME=cloudcare                                    # dedicated, key-only, no-sudo user — see docs/VPS_SETUP.md
VPS_SSH_KEY_PATH=~/.ssh/cloudcare_vps
VPS_SSH_KEY_PASSPHRASE=                                   # unlocks the encrypted key file — never a login password
VPS_COMPANY_NAME=CloudCare                                # FOCUS PublisherName for modelled VPS cost rows
VPS_MONTHLY_COST=0                                        # fixed monthly figure — cost is modelled, never observed
VPS_MONTHLY_COST_CURRENCY=INR
VPS_METRICS_ENDPOINT=                                     # optional Prometheus/node_exporter URL; preferred over SSH
VPS_SAR_BACKFILL_ENABLED=true                             # one-time sysstat backfill for a real 14-day history on first connect
VPS_SAR_BACKFILL_DAYS=14

# ---------------------------------------------------------------------------
# Currency — USD is the stored FOCUS currency everywhere; INR is a
# display-only subscript computed at render time, never written into a
# FOCUS column (see services/focus/mappers/vps.py's x_OriginalBilledCost).
# ---------------------------------------------------------------------------
USD_TO_INR=83.0

# ---------------------------------------------------------------------------
# LLM provider — GPT-4o, shared by the Decision agent (Phase 4) and the
# chatbot (Phase 7) via services/llm/client.py.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=                                           # required for Decision's LLM reasoning; degrades cleanly if unset
OPENAI_BASE_URL=https://api.openai.com/v1                 # override to route through an OpenAI-compatible proxy
OPENAI_MODEL=gpt-4o
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Execution safety (Phase 6 — services/executor/actions.py)
# ---------------------------------------------------------------------------
EXECUTION_ENABLED=false                                   # hard gate — keep false until tested
EXECUTION_MODE=simulation                                 # simulation | live
EXECUTION_ALLOWLIST_TAG=cloudcare:managed=true            # hard gate, in any mode — no exceptions
AWS_WRITE_ROLE_ARN=                                       # SEPARATE role from AWS_READ_ROLE_ARN — see CLOUDCARE_BUILD_PLAN.md

# ---------------------------------------------------------------------------
# Scheduler — hourly Monitor -> Analyzer -> Decision -> Supervisor pipeline
# ---------------------------------------------------------------------------
SCHEDULER_ENABLED=true                                     # set false to disable during tests
SCHEDULER_INTERVAL_MINUTES=60                               # how often the hourly job repeats
