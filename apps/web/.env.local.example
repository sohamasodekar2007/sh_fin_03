# FastAPI backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# NextAuth — MUST be byte-for-byte identical to NEXTAUTH_SECRET in
# apps/api/.env (that's how FastAPI trusts a JWT this app mints). Generate
# with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-only-insecure-secret-change-me

# MongoDB — same cluster/database as apps/api/.env's MONGODB_URI. NextAuth's
# CredentialsProvider reads/writes the `users` collection directly.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=cloudcare

# OAuth providers — leave any of these empty to simply hide that button;
# CredentialsProvider (email/password) always works regardless.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common
